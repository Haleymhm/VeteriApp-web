generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VET
  RECEPTIONIST
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Sex {
  MALE
  FEMALE
}

enum ReproductiveStatus {
  FERTILE
  STERILIZED
  CASTRATED
}

enum DewormingType {
  INTERNAL
  EXTERNAL
  BOTH
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  rut       String?  @unique
  phone     String?
  address   String?
  regionId  String?
  comunaId  String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region    Region?    @relation(fields: [regionId], references: [id])
  comuna    Comuna?    @relation(fields: [comunaId], references: [id])
  pets               Pet[]
  vetAppointments    Appointment[] @relation("VetAppointments")
  medicalRecords     MedicalRecord[]
  vaccinations       Vaccination[]
  dewormingRecords   Deworming[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
  clinicSettings      ClinicSetting[] @relation("ClinicSettingUpdatedBy")
  clinicHolidaysCreated ClinicHoliday[] @relation("ClinicHolidayCreatedBy")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([name])
}

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   String
  breed     String?
  birthDate DateTime?
  weight    Float?
  sex       Sex?
  reproductiveStatus ReproductiveStatus?
  specialCharacteristics String?  @db.Text
  microchipNumber        String?
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  vaccinations      Vaccination[]
  dewormingRecords  Deworming[]
  surgicalHistory   SurgicalHistory[]
  chronicConditions ChronicCondition[]
}

model Appointment {
  id        String            @id @default(uuid())
  date      DateTime
  reason    String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  petId     String
  vetId     String?
  categoryId String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  pet      Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  vet      User?    @relation("VetAppointments", fields: [vetId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
}

model MedicalRecord {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  title        String
  diagnosis    String?  @db.Text
  treatment    String?  @db.Text
  publicNotes  String   @db.Text
  privateNotes String?  @db.Text
  petId        String
  vetId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pet    Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  vet    User            @relation(fields: [vetId], references: [id])
  vitals VitalSigns?
  exams  ExamAttachment[]
}

model VitalSigns {
  id                    String  @id @default(uuid())
  weight                Float?
  temperature           Float?
  heartRate             Int?
  respiratoryRate       Int?
  capillaryRefillTime   String?
  dehydrationPercentage Float?
  mucousMembranes       String?
  medicalRecordId       String  @unique

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model ExamAttachment {
  id              String   @id @default(uuid())
  fileName        String
  fileUrl         String
  fileType        String
  description     String?
  medicalRecordId String
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

model Vaccination {
  id                 String    @id @default(uuid())
  vaccineName        String
  vaccineType        String
  administrationDate DateTime  @default(now())
  nextDoseDate       DateTime?
  lotNumber          String?
  manufacturer       String?
  veterinarian       String?
  petId              String
  createdById        String
  createdAt          DateTime  @default(now())

  pet        Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy  User  @relation(fields: [createdById], references: [id])
}

model Deworming {
  id          String       @id @default(uuid())
  productName String
  type        DewormingType
  dosage      String?
  date        DateTime     @default(now())
  nextDate    DateTime?
  petId       String
  createdById String
  createdAt   DateTime     @default(now())

  pet       Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])
}

model SurgicalHistory {
  id          String    @id @default(uuid())
  procedure   String
  date        DateTime?
  complications String?  @db.Text
  notes       String?   @db.Text
  outcomes    String?   @db.Text
  petId       String
  createdAt   DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model ChronicCondition {
  id            String    @id @default(uuid())
  name          String
  type          String
  severity      String?
  diagnosisDate DateTime?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  petId         String
  createdAt     DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  comunas   Comuna[]
  clients   User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Comuna {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  clients   User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model AuditLog {
  id           String    @id @default(uuid())
  userId       String
  userFullName String
  userEmail    String
  action       String
  module       String
  entityId     String
  entityType   String
  timestamp    DateTime  @default(now())
  ipAddress    String?
  previousHash String
  signature    String

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details AuditLogDetail[]

  @@index([userId])
  @@index([entityId])
  @@index([action])
  @@index([module])
  @@index([timestamp])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLogDetail {
  id        String  @id @default(uuid())
  fieldName String
  oldValue  String?
  newValue  String?

  auditLogId String
  auditLog   AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([auditLogId])
}

model ClinicSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("ClinicSettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([key])
}

model ClinicHoliday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  label       String
  createdById String
  createdBy   User     @relation("ClinicHolidayCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
}